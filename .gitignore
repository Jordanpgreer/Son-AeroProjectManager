# ---------------------------------------------------------------------------
# SON-AERO Internal Hub — monorepo .gitignore
# Patterns without a leading slash apply in every app (apps/*, shared, etc.).
# ---------------------------------------------------------------------------

# Build output (any app)
bin/
obj/
publish/
deployment/artifacts/
dist/
wwwroot/

# Frontend dependencies and generated output (any app)
node_modules/

# Local databases (the tracked demo DB apps/project-tracker/.../project-tracker-dev.db
# stays tracked because git ignore rules never apply to already-tracked files)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Local Engineering Hub controlled drawing storage
engineering-files/

# Local test/browser artifacts
.playwright-cli/
.playwright-mcp/
output/
tmp/
test-results/
playwright-report/

# User/local machine files
*.user
*.suo
.vs/
.vscode/
.idea/
*.log

# Hub / launcher runtime artifacts (kept outside source)
logs/
.hub-build-stamp
.projects-build-stamp
*-launch.out.log
*-launch.err.log

# Generated/exported reports
*.xlsx
*.pdf
!Project Tracker.xlsm

# Legacy workbook backups / intermediate repair copies (kept locally under
# data/project-tracker/legacy-workbooks but not tracked)
Project Tracker.backup-*.xlsm
Project Tracker - *.xlsm

# Codex local configuration
.codex/

# Local coding-agent and swarm configuration/runtime data
/.agents/
/.claude/
/.claude-flow/
/.swarm/
/AGENTS.md

# Environment variables
.env
.env.local
.env.*.local

# Private certificate/key material (pilot bundles must also be created outside a Git worktree)
*.pfx
*.p12
*.pem
*.key
