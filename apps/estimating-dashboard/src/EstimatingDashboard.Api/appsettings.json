{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Mode": "Windows"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "EnterpriseQuoteSync": {
    "Enabled": false,
    "TimeZoneId": "Mountain Standard Time"
  },
  "FulcrumQuoteSync": {
    "BaseUrl": "https://api.fulcrumpro.us/",
    "PageSize": 5000,
    "CustomFields": {
      "CustomerContact": "CustomerContact",
      "RfqReferenceNumber": "RFQ/REF No",
      "RfqDueDate": "RFQ Due Date",
      "DateToEstimating": "Date to Estimating",
      "Issues": "Issues?",
      "QuoteOnTrack": "Quote On Track?",
      "QuoteComplexity": "Quote Complexity",
      "NumberOfParts": "Number of Parts in Quote",
      "EstimatingStatus": "Estimating Status",
      "EstimatingRep": "Estimating Rep",
      "EstimatingCompletionDate": "Estimating Completion Date"
    }
  },
  "ConnectionStrings": {
    "ModuleAccessStore": "Server=.\\SQLEXPRESS;Database=ProjectTracker;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  }
}
