{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Mode": "Windows"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "RoleStore": "Server=.\\SQLEXPRESS;Database=ProjectTracker;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "EngineeringStore": "Data Source=engineering-hub.db"
  },
  "EngineeringDatabase": {
    "Provider": "Sqlite"
  },
  "DrawingStorage": {
    "RootPath": "",
    "RequireUncPath": true
  },
  "Engineering": {
    "DevelopmentRole": "Admin",
    "Admins": []
  }
}
