{
  "UniversalFulcrumSync": {
    "Enabled": true,
    "IntervalMinutes": 20,
    "MaximumConcurrentRequests": 2,
    "MinimumRequestSpacingMilliseconds": 250,
    "MaximumStaleMinutes": 1440
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Mode": "Windows"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "QualityDatabase": {
    "Provider": "SqlServer"
  },
  "QualityWorkflow": {
    "QualityGroupName": "Quality",
    "ShippingGroupName": "Shipper"
  },
  "QualityIntegration": {
    "Enabled": true,
    "FulcrumBaseUrl": "https://api.fulcrumpro.us/",
    "FulcrumShipmentUrlTemplate": "https://son-aero.fulcrumpro.com/ui/ship/{id}/details",
    "SyncIntervalMinutes": 20,
    "PageSize": 5000
  },
  "PortalPush": {
    "Enabled": false,
    "BaseUrl": "",
    "ProducerKey": ""
  },
  "ConnectionStrings": {
    "ModuleAccessStore": "Server=.\\SQLEXPRESS;Database=ProjectTracker;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "QualityStore": "Server=.\\SQLEXPRESS;Database=QualityAssurance;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  }
}
